---
// URL absoluta da página atual, baseada no `site` do astro.config.mjs
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<title>Portifolio Utida</title>
<meta
  name="description"
  content="Portfólio de tecnólogo criativo. Código, design e estratégia para produtos digitais com propósito."
/>
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph -->
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content="portfolio dos inscritos" />
<meta
  property="og:description"
  content="Portfólio de tecnólogo criativo. Código, design e estratégia para produtos digitais com propósito."
/>
<meta property="og:site_name" content="Portifolio Utida" />
<meta property="og:type" content="website" />
<meta property="og:locale" content="pt_BR" />

<!-- Twitter -->
<meta name="twitter:card" content="summary" />
