---
import { getLinkHref } from "@/lib/getContent";

interface Props {
  linkKey: string;
  textKey?: string;
  href: string;
  class?: string;
}

const { linkKey, textKey = linkKey, href, class: className = "", ...rest } = Astro.props;
const resolvedHref = getLinkHref(linkKey, href);
---

<a href={resolvedHref} data-editable-link={linkKey} class={className} {...rest}>
  <span data-editable={textKey}><slot /></span>
</a>
