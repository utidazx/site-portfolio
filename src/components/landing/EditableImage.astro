---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getImageSrc } from "@/lib/getContent";

interface Props {
  imageKey: string;
  src: ImageMetadata;
  alt: string;
  width: number;
  height: number;
  class?: string;
  loading?: "lazy" | "eager";
  decoding?: "async" | "auto" | "sync";
}

const {
  imageKey,
  src,
  alt,
  width,
  height,
  class: className = "",
  loading = "lazy",
  decoding = "async",
} = Astro.props;

const overrideSrc = getImageSrc(imageKey);
---

<div class="editable-image group/image relative">
  {
    overrideSrc ? (
      <img
        src={overrideSrc}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        decoding={decoding}
        class={className}
        data-editable-image={imageKey}
      />
    ) : (
      <Image
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        decoding={decoding}
        class={className}
        data-editable-image={imageKey}
      />
    )
  }
</div>
